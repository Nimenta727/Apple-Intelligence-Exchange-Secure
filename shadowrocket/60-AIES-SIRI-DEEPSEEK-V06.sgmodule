#!name=AIES 60 - Siri DeepSeek v0.6 Clean Beta (UNVERIFIED ON SIRI)
#!desc=Single install, Siri text -> DeepSeek answer rewrite. Experimental: original query may reach Qwen.
#!system=ios

# Installs two rewrite hooks plus one narrowly scoped Siri-only follow-up SSE guard.
# For this mode only, the prior 00 REJECT module conflicts and must be OFF.
# Guard only covers observed /v1/sessions/<id>/responses SSE, not the full Qwen service.
# A guarded follow-up may display a Siri "unable to obtain answer" error.
# No guarantee of rewriting if Shadowrocket is off or iOS bypasses MITM.
# Requires user-provisioned SAIRS_DEEPSEEK_API_KEY in local persistent store.
[MITM]
hostname = %APPEND% prod-yabuli.qianwen.com

[Script]
AIES60 Capture = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/responses(?:\?.*)?$,requires-body=true,max-size=307200,timeout=20,script-path=https://raw.githubusercontent.com/Nimenta727/Apple-Intelligence-Exchange-Secure/d8472b61e546da447b64f16bf1580933b4dce368/scripts/aies_siri_deepseek_v06.js
AIES60 Rewrite = type=http-response,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/responses(?:\?.*)?$,requires-body=true,max-size=921600,timeout=20,script-path=https://raw.githubusercontent.com/Nimenta727/Apple-Intelligence-Exchange-Secure/d8472b61e546da447b64f16bf1580933b4dce368/scripts/aies_siri_deepseek_v06.js
AIES60 Scoped Qwen SSE Guard = type=http-response,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/[^\/?#]{1,160}\/responses(?:\?.*)?$,requires-body=true,max-size=921600,timeout=20,script-path=https://raw.githubusercontent.com/Nimenta727/Apple-Intelligence-Exchange-Secure/d8472b61e546da447b64f16bf1580933b4dce368/scripts/aies_siri_deepseek_v06.js
