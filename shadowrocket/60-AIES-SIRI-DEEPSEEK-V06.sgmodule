#!name=AIES 60 - Siri + WritingTools DeepSeek v0.6 Beta
#!desc=Siri text, verified same-session followups and scoped WritingTools Compose -> DeepSeek. Beta; original Qwen request may reach Qwen.
#!system=ios

# Two main Siri/WritingTools hooks and two Siri session-followup request/response hooks.
# For this mode only, the prior 00 REJECT module conflicts and must be OFF.
# Followup requires verified DeepSeek context (local 5min TTL), same session and transaction tag.
# For previous_choice_id empty string ONLY, fallback to latest DeepSeek choice from EXACT URL session; invalid non-empty pointers still fail closed.
# Unsupported/unmatched followup remains fail-closed and can display a Siri error.
# WritingTools Beta only supports the exact SAIR-observed Compose text group; other modes fail closed.
# No guarantee of rewriting if Shadowrocket is off or iOS bypasses MITM.
# Requires user-provisioned SAIRS_DEEPSEEK_API_KEY in local persistent store.
[MITM]
hostname = %APPEND% prod-yabuli.qianwen.com

[Script]
AIES60 Capture = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/responses(?:\?.*)?$,requires-body=true,max-size=307200,timeout=20,script-path=https://raw.githubusercontent.com/Nimenta727/Apple-Intelligence-Exchange-Secure/c9e8ac6332c7726594006fd243839742dba5d88a/scripts/aies_siri_deepseek_v06.js
AIES60 Rewrite = type=http-response,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/responses(?:\?.*)?$,requires-body=true,max-size=921600,timeout=20,script-path=https://raw.githubusercontent.com/Nimenta727/Apple-Intelligence-Exchange-Secure/c9e8ac6332c7726594006fd243839742dba5d88a/scripts/aies_siri_deepseek_v06.js
AIES60 Followup Capture = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/[^\/?#]{1,160}\/responses(?:\?.*)?$,requires-body=true,max-size=307200,timeout=20,script-path=https://raw.githubusercontent.com/Nimenta727/Apple-Intelligence-Exchange-Secure/c9e8ac6332c7726594006fd243839742dba5d88a/scripts/aies_siri_deepseek_v06.js
AIES60 Followup Rewrite = type=http-response,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/[^\/?#]{1,160}\/responses(?:\?.*)?$,requires-body=true,max-size=921600,timeout=20,script-path=https://raw.githubusercontent.com/Nimenta727/Apple-Intelligence-Exchange-Secure/c9e8ac6332c7726594006fd243839742dba5d88a/scripts/aies_siri_deepseek_v06.js
