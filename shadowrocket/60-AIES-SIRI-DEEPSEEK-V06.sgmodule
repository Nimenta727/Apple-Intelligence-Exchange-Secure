#!name=AIES 60 - Siri DeepSeek v0.6 Clean Beta (UNVERIFIED ON SIRI)
#!desc=Single install, Siri text -> DeepSeek answer rewrite. Experimental: original query may reach Qwen.
#!system=ios

# Installs two hooks using one local logic script.
# For this mode only, the prior 00 REJECT module conflicts and must be OFF.
# No guarantee of rewriting if Shadowrocket is off or iOS bypasses MITM.
# Requires user-provisioned SAIRS_DEEPSEEK_API_KEY in local persistent store.
[MITM]
hostname = %APPEND% prod-yabuli.qianwen.com

[Script]
AIES60 Capture = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/responses(?:\?.*)?$,requires-body=true,max-size=307200,timeout=20,script-path=https://raw.githubusercontent.com/Nimenta727/Apple-Intelligence-Exchange-Secure/b0994a5b30b69ef8d67dd96a2f6c36577f81c946/scripts/aies_siri_deepseek_v06.js
AIES60 Rewrite = type=http-response,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/responses(?:\?.*)?$,requires-body=true,max-size=921600,timeout=20,script-path=https://raw.githubusercontent.com/Nimenta727/Apple-Intelligence-Exchange-Secure/b0994a5b30b69ef8d67dd96a2f6c36577f81c946/scripts/aies_siri_deepseek_v06.js
