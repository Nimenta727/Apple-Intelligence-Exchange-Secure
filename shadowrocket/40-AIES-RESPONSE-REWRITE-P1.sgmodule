#!name=AIES 40 - Fixed HTTPS Response Rewrite P1 (NOT SIRI)
#!desc=Temporary smoke test of http-response on a public non-sensitive fixture. DO NOT USE FOR SIRI.
#!system=ios

# WARNING: MITM trust for raw.githubusercontent.com affects that entire host
# while this module is enabled. Enable only briefly for the single fixture test.
# The Script URL pattern below is scoped to one public text file.
[MITM]
hostname = %APPEND% raw.githubusercontent.com

[Script]
AIES P1 Response Rewrite = type=http-response,pattern=^https:\/\/raw\.githubusercontent\.com\/Nimenta727\/Apple-Intelligence-Exchange-Secure\/siri-deepseek-response-rewrite\/tests\/fixtures\/p1-http-origin\.txt$,requires-body=true,max-size=4096,timeout=10,engine=jsc,script-path=Script/aies_response_rewrite_probe.js
