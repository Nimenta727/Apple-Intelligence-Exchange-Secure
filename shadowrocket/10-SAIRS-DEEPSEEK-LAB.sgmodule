#!name=Apple Intelligence Exchange Secure - 10 DeepSeek Lab UNVERIFIED
#!desc=Experimental local request mock via DeepSeek; REJECT safety backstop; REAL-DEVICE TEST REQUIRED.
#!author=Apple Intelligence Exchange Secure contributors (original research: boitar/sair, MIT)
#!system=ios

[MITM]
hostname = %APPEND% prod-yabuli.qianwen.com

[Script]
# Save scripts/sairs_router.js to Shadowrocket local Script folder.
# Use Script/ prefix for local scripts; see device instructions and confirm script diagnostics.
AIES DeepSeek Lab = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/.*,requires-body=true,max-size=314572,timeout=25,script-path=Script/sairs_router.js

[Rule]
# May run before the script. If so Siri is blocked rather than redirected.
# NEVER delete this protection to force Siri to work.
DOMAIN,prod-yabuli.qianwen.com,REJECT
