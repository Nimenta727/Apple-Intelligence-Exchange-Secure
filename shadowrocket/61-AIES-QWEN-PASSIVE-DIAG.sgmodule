#!name=AIES 61 - Qwen Original PASSIVE Protocol Diagnostic (no rewrite)
#!desc=Temporary native Siri-to-Qwen text/SSE STRUCTURE capture only. Disable AIES 60/old REJECT first. Always passes traffic unchanged. Manual 600s opt-in required.
#!system=ios

# ISOLATED diagnostic mode; never run together with AIES 60 or 00 REJECT.
# Only observes one Siri POST request and one target response, no text values.
# Does NOT route traffic, call DeepSeek, inject headers, change body/status or block Qwen.
# Requires trusted local Shadowrocket MITM for target host; disable afterward.
[MITM]
hostname = %APPEND% prod-yabuli.qianwen.com

[Script]
AIES61 Passive Request = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/responses(?:\?.*)?$,requires-body=true,max-size=307200,timeout=20,script-path=https://raw.githubusercontent.com/Nimenta727/Apple-Intelligence-Exchange-Secure/eded04f046b8bd1a53af7de2258eda265969442c/scripts/aies_qwen_passive_diag.js
AIES61 Passive Response = type=http-response,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/responses(?:\?.*)?$,requires-body=true,max-size=921600,timeout=20,script-path=https://raw.githubusercontent.com/Nimenta727/Apple-Intelligence-Exchange-Secure/eded04f046b8bd1a53af7de2258eda265969442c/scripts/aies_qwen_passive_diag.js
