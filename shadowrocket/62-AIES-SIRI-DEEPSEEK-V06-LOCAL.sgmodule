#!name=AIES 60 LOCAL - Siri DeepSeek v0.6 Beta
#!desc=LOCAL script deployment when raw.githubusercontent.com HTTPS proxy download fails. Requires local Script/aies_siri_deepseek_v06.js; experimental; original Qwen request may reach Qwen.
#!system=ios

# OFFLINE-LOCAL DEPLOYMENT: all four hooks reference one local Script file, not GitHub raw.
# Shadowrocket local script example uses script-path=Script/header.js. Four hooks now explicitly use Script/aies_siri_deepseek_v06.js,enable=true.
# Check Files > iCloud Drive > Shadowrocket > Script > aies_siri_deepseek_v06.js.
# A file visible only in On My iPad/Script Test may NOT be found by the module HTTP hooks.
# New source supports absent/null/empty previous choice fallback only from same verified DeepSeek session.
# It also supports known Siri TQA pure-text followups; unknown groups and missing response tags remain fail-closed.
# LOCAL JS must match reviewed commit 637484295c10627f06e610bfe040dd58e67d309a; iCloud file must be fully downloaded.
# Do not turn on together with remote 60, diagnostic 61 or any historical 00 REJECT.
# Local file resolution varies by Shadowrocket version: verify in actual device logs BEFORE any Siri trial.
# Two main Siri/WritingTools hooks and two Siri session-followup request/response hooks.
# For this mode only, the prior 00 REJECT module conflicts and must be OFF.
# Followup requires a verified previous DeepSeek choice context (local 5min TTL), same session and transaction tag.
# Unsupported/unmatched followup remains fail-closed and can display a Siri error.
# WritingTools Beta only supports the exact SAIR-observed Compose text group; other modes fail closed.
# No guarantee of rewriting if Shadowrocket is off or iOS bypasses MITM.
# Requires user-provisioned SAIRS_DEEPSEEK_API_KEY in local persistent store.
[MITM]
hostname = %APPEND% prod-yabuli.qianwen.com

[Script]
AIES60 Capture = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/responses(?:\?.*)?$,requires-body=true,max-size=307200,timeout=20,script-path=Script/aies_siri_deepseek_v06.js,enable=true
AIES60 Rewrite = type=http-response,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/responses(?:\?.*)?$,requires-body=true,max-size=921600,timeout=20,script-path=Script/aies_siri_deepseek_v06.js,enable=true
AIES60 Followup Capture = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/[^\/?#]{1,160}\/responses(?:\?.*)?$,requires-body=true,max-size=307200,timeout=20,script-path=Script/aies_siri_deepseek_v06.js,enable=true
AIES60 Followup Rewrite = type=http-response,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/[^\/?#]{1,160}\/responses(?:\?.*)?$,requires-body=true,max-size=921600,timeout=20,script-path=Script/aies_siri_deepseek_v06.js,enable=true
