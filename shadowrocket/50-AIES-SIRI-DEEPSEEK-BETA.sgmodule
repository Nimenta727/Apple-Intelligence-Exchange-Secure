#!name=AIES 50 - Siri DeepSeek Response Beta (REAL SIRI TEST UNVERIFIED)
#!desc=One-module DeepSeek-only answer rewrite for Siri text; experimental; Qwen may receive original request; no fallback in script.
#!author=AIES contributors; prior research boitar/sair MIT
#!system=ios

# IMPORTANT:
# 00-SAIRS-LOCKDOWN MUST be disabled for this NEW mode or REJECT wins.
# This module NEVER grants a no-Qwen-egress guarantee.
# The single script runs in both request and response stages.
# The remote script follows the designated experimental branch; review code before enabling.

[MITM]
hostname = %APPEND% prod-yabuli.qianwen.com

[Script]
AIES 50 Siri Capture = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/responses(?:\?.*)?$,requires-body=true,max-size=307200,timeout=20,script-path=https://raw.githubusercontent.com/Nimenta727/Apple-Intelligence-Exchange-Secure/siri-deepseek-response-rewrite/scripts/aies_siri_deepseek_beta.js
AIES 50 DeepSeek Rewrite = type=http-response,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/responses(?:\?.*)?$,requires-body=true,max-size=921600,timeout=20,script-path=https://raw.githubusercontent.com/Nimenta727/Apple-Intelligence-Exchange-Secure/siri-deepseek-response-rewrite/scripts/aies_siri_deepseek_beta.js

# No [Rule] here: 00 is an incompatible older deployment mode.
# HTTP response hook may not fire on all upstream/streaming/system fallback paths.
