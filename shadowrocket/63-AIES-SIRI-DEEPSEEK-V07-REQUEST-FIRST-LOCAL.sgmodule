#!name=AIES 63 DISABLED - Siri v0.7 Request First (Device Failure)
#!desc=KNOWN REAL-DEVICE FAILURE (2026-11-20): 6 DeepSeek calls completed and synthetic HTTP responses were emitted, but Siri displayed no answers. Module DISABLED by default. Use 62 LOCAL instead; source retained for research only.
#!system=ios

# QUARANTINED: USER IPAD VALIDATION FAILED ON 2026-11-20.
# DO NOT USE AS A SOLUTION: six [AIES_V07] LOCAL_SSE_RESPONSE_READY and
# six Shadowrocket "script http request send early response to client",
# but Siri UI showed no usable answer, and no session followup appeared.
# Keep disabled (enable=false) while researching native Siri response contract.
# Working rollback: turn off 63, turn on 62 LOCAL with v0.6 JS.
# Original prototype retained solely for experimental source review.
# Enable only 63 OR 62/60/61 -- NEVER together. Disable all historical 00 REJECT hooks.
# If Siri rejects synthetic SSE or followup, DISABLE 63 and return to working 62.
# Install scripts/aies_siri_deepseek_v07_request_first.js to iCloud Drive/Shadowrocket/Script/
# Script-path is local; no runtime GitHub download. Keep SAIRS_DEEPSEEK_API_KEY in existing persistent store.
# Only TWO http-request hooks. This is intentional: new design does not wait for upstream response.
# A valid Siri text request is answered by locally synthesized Siri SSE after a verified DeepSeek API call.
# Unsupported/failed calls return error (fail closed); never pass Qwen text off as DeepSeek.
# For followups, SAME URL session + verified local DeepSeek history required. Unknown Siri
# group is structural-text only, with safeguards against common tool/media group names.
# This mode does not support WritingTools or non-Siri user agents.
# Source review: scripts/aies_siri_deepseek_v07_request_first.js (same commit as this module).
# This cannot prevent bypass at iOS/network level when script does not intercept a request.
[MITM]
hostname = %APPEND% prod-yabuli.qianwen.com

[Script]
AIES63 Request Main = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/responses(?:\?.*)?$,requires-body=true,max-size=307200,timeout=20,script-path=Script/aies_siri_deepseek_v07_request_first.js,enable=false
AIES63 Request Followup = type=http-request,pattern=^https:\/\/prod-yabuli\.qianwen\.com\/v1\/sessions\/[^\/?#]{1,160}\/responses(?:\?.*)?$,requires-body=true,max-size=307200,timeout=20,script-path=Script/aies_siri_deepseek_v07_request_first.js,enable=false
